// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The four roles of TOR section 2. Flat, not nested: section 2 states an Administrator is not
/// automatically granted transaction approval rights, so only MANAGER approves purchase orders
/// and adjusts stock. Mirrored by RoleSchema in @erp/contracts.
enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

/// A RetailOne branch (MD-03). `code` is the business key people type and read on documents
/// (B01, B02); `id` stays internal so a code can be corrected without rewriting history.
model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  products  ProductStore[]
}

/// A supplier (MD-03). `code` is the business key, unique across the organisation, the same
/// rule as `Store.code`. `phone` and `address` are the only contact details #6 scopes in: both
/// optional, both nullable, neither validated for shape, because no feature reads either yet.
model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A catalogue item (MD-01). `sku` is the business key, unique across the organisation.
/// `active` lets a product be deactivated without deleting it: MD-02 requires it to stay
/// searchable in historical records while being refused on any new document.
model Product {
  id           String         @id @default(cuid())
  sku          String         @unique
  name         String
  category     String
  unit         String
  /// Two decimal places, per TOR section 4.3. Decimal, not Float, so money never drifts.
  sellingPrice Decimal        @db.Decimal(10, 2)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  stores       ProductStore[]
}

/// The reorder threshold and stock balance are per store (MD-01), so neither is a column on
/// Product; both live here instead. Created eagerly -- for every store when a product is
/// created, and for every product when a store is created -- so a product that has never moved
/// still has a row: lazy creation on first movement would leave a zero-stock product with no
/// row, which would silently break the low-stock report (INV-01/RPT-02) where it must still
/// appear.
model ProductStore {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  balance          Int      @default(0)
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, storeId])
  @@index([storeId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// At most one store assignment, by construction: one nullable column, not a join table.
  /// Required for STORE_EMPLOYEE; absent for the cross-store roles (ADMINISTRATOR, MANAGER,
  /// PURCHASING_OFFICER). The database cannot express "required for one role only", so the rule
  /// is asserted where it is observable: the seed, and the handler assertions NFR-01 requires.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

/// NFR-03: every authorisation outcome worth explaining later is recorded here. The first
/// producer is an authorisation refusal, which is why this model arrives with the store rules.
model AuditLog {
  id         String       @id @default(cuid())
  /// Who attempted it. Kept as a plain column, not a relation, so deleting a user never erases
  /// the trail.
  actorId    String
  actorEmail String
  actorRole  Role
  /// What was attempted, e.g. `stores.read`.
  action     String
  /// Which entity was aimed at, e.g. a store code. Null when the action names no single target.
  target     String?
  outcome    AuditOutcome
  /// Why it ended that way, in one line.
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

enum AuditOutcome {
  ALLOWED
  REFUSED
}
